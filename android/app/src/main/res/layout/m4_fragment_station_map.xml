<?xml version="1.0" encoding="utf-8"?>
<!-- Member 4: shared native station map, API results and optional location controls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/gray_100">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingHorizontal="8dp" android:background="@color/emerald_600">
        <ImageButton android:id="@+id/m4Back" android:layout_width="48dp" android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="@string/m4_back" app:tint="@color/white" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/m4_nearby_stations" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/m4Refresh" android:layout_width="48dp" android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="@string/m4_refresh" app:tint="@color/white" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingTop="8dp">
        <EditText android:id="@+id/m4Search" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="48dp" android:hint="@string/m4_search_hint" android:inputType="text"
            android:imeOptions="actionSearch" android:importantForAutofill="no"
            android:maxLines="1" android:maxLength="100" android:textSize="16sp" />
        <ImageButton android:id="@+id/m4SearchSubmit" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_menu_search"
            android:contentDescription="@string/m4_search" app:tint="@color/emerald_600" />
        <ImageButton android:id="@+id/m4SearchClear" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="@string/m4_clear" app:tint="@color/gray_500" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/m4All"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/m4_all" app:cornerRadius="24dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/m4Near"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:text="@string/m4_near_me" app:cornerRadius="24dp" />
    </LinearLayout>
    <TextView android:id="@+id/m4LocationMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="16dp" android:paddingBottom="4dp" android:textColor="@color/gray_900"
        android:visibility="gone" android:accessibilityLiveRegion="polite" />

    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1.2" android:layout_marginHorizontal="16dp"
        app:cardCornerRadius="16dp" app:cardElevation="0dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <androidx.fragment.app.FragmentContainerView android:id="@+id/m4MapContainer"
                android:layout_width="match_parent" android:layout_height="match_parent" />
            <TextView android:id="@+id/m4MapMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="top" android:padding="12dp" android:background="#EEFFFFFF"
                android:text="@string/m4_loading_map" android:textColor="@color/gray_900" android:accessibilityLiveRegion="polite" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView android:id="@+id/m4ResultTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="16dp" android:paddingTop="12dp" android:paddingBottom="4dp"
        android:text="@string/m4_stations" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/gray_900" />
    <ProgressBar android:id="@+id/m4Loading" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true" />
    <TextView android:id="@+id/m4DataMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="16dp" android:paddingVertical="4dp" android:textColor="@color/gray_900"
        android:visibility="gone" android:accessibilityLiveRegion="polite" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/m4Stations"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:paddingHorizontal="16dp" android:paddingBottom="12dp" android:clipToPadding="false" />
</LinearLayout>
