<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ========================================================= -->
    <!-- SCROLLABLE DASHBOARD -->
    <!-- ========================================================= -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F3F4F6"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ================================================= -->
            <!-- TOP HEADER -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginBottom="-30dp"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Background Image -->

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/home_back"
                        android:contentDescription="Dashboard background" />

                    <!-- Dark Grid Operator Overlay -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#990F2942" />


                    <!-- ========================================= -->
                    <!-- APP TITLE -->
                    <!-- ========================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="60dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp">

                        <!-- App Logo -->

                        <ImageView
                            android:id="@+id/ivAppIcon"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_remove_app_logo"
                            android:contentDescription="Smart Solar Microgrid" />

                        <!-- App Name -->

                        <LinearLayout
                            android:layout_width="315dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Smart Solar Microgrid"
                                android:textColor="#FFFFFF"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Grid Operations &amp; Management"
                                android:textColor="#DBEAFE"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/btnMenu"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            app:tint="#FFF" />

                        <!-- Notification -->

                    </LinearLayout>


                    <!-- ========================================= -->
                    <!-- OPERATOR PROFILE -->
                    <!-- ========================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="20dp"
                        android:paddingBottom="60dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="#FFFFFF"
                            android:padding="12dp"
                            android:src="@drawable/ic_account_circle_24"
                            android:contentDescription="Grid Operator"
                            app:tint="#0F766E" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Welcome,"
                                android:textColor="#E5E7EB"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvWelcomeName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Grid Operator"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="● Grid Operator"
                                android:textColor="#6EE7B7"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- MICROGRID STATUS CARD -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="-30dp"
                app:cardBackgroundColor="#0F766E"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Microgrid Status"
                            android:textColor="#CCFBF1"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvGridStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="System Operational"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="All core services are running normally"
                            android:textColor="#A7F3D0"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- Status Indicator -->

                    <TextView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="#337EE8C4"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- Member 4: live reservation dashboard, preserving existing quick actions. -->
            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/m4OperatorSummaryContainer"
                android:name="com.smartsolar.microgrid.member4.operator.OperatorSummaryFragment"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" />

            <!-- QUICK ACTIONS -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="Quick Actions"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold" />


            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:paddingHorizontal="10dp"
                android:useDefaultMargins="false">


                <!-- QR APPROVALS -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQrApproval"
                    style="@style/Widget.SmartSolar.OperatorQuickAction"
                    android:text="@string/m4_scan_qr"
                    app:icon="@drawable/ic_qr_code_24"
                     />


                <!-- SYSTEM MANAGEMENT -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManagement"
                    style="@style/Widget.SmartSolar.OperatorQuickAction"
                    android:text="System Management"
                    app:icon="@drawable/m4_ic_settings"
                     />


                <!-- MONITOR STATIONS -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMonitorStations"
                    style="@style/Widget.SmartSolar.OperatorQuickAction"
                    android:text="@string/m4_station_map"
                    app:icon="@drawable/ic_share_location_24"
                    app:backgroundTint="#ECFDF5" app:strokeColor="#BBE7D3" />


                <!-- RESERVATIONS -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReservations"
                    style="@style/Widget.SmartSolar.OperatorQuickAction"
                    android:text="Reservations"
                    app:icon="@drawable/ic_add_notes_24"
                    app:backgroundTint="#047857" app:strokeColor="#047857" app:iconTint="#FFFFFF" android:textColor="#FFFFFF" />


                <!-- MANAGE USERS -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUsers"
                    style="@style/Widget.SmartSolar.OperatorQuickAction"
                    android:text="Manage Users"
                    app:icon="@drawable/ic_account_circle_24"
                     />


                <!-- LOGOUT -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.SmartSolar.OperatorQuickAction"
                    android:text="Logout"
                    app:icon="@drawable/m4_ic_logout"
                    app:backgroundTint="#FFF5F4" app:strokeColor="#F5D5D0" app:iconTint="#B42318" android:textColor="#B42318" app:rippleColor="#22B42318" />

            </GridLayout>


            <!-- ================================================= -->
            <!-- GRID OPERATION STATUS -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_app_badging_24"
                        app:tint="#0F766E" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Grid Operations"
                            android:textColor="#111827"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Monitor and manage microgrid operations"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ONLINE"
                        android:textColor="#059669"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ========================================================= -->
    <!-- FIXED BOTTOM NAVIGATION -->
    <!-- ========================================================= -->

    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:backgroundTint="#FFFFFF"
        app:elevation="12dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemIconSize="24dp"
            app:itemIconTint="@color/grid_operator_bottom_nav_color"
            app:itemTextColor="@color/grid_operator_bottom_nav_color"
            app:itemRippleColor="#D1FAE5"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/grid_operator_bottom_nav_menu" />

    </com.google.android.material.bottomappbar.BottomAppBar>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- SIDEBAR NAVIGATION DRAWER -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_menu" />

</androidx.drawerlayout.widget.DrawerLayout>