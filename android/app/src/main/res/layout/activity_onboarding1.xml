<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/white">

    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@drawable/bg_remove_app_logo"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Smart Solar"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/emerald_600"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage your microgrid and solar energy usage efficiently."
        android:textSize="16sp"
        android:textAlignment="center"
        android:textColor="@color/gray_500"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Next"
        android:backgroundTint="@color/emerald_500"
        android:textColor="@color/white"
        android:padding="12dp"
        android:textAllCaps="false"
        android:textSize="16sp"/>

</LinearLayout>
