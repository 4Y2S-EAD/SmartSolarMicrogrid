<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F3F7F6">
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="12dp" android:background="#073E35">
        <ImageButton android:id="@+id/m4QrClose" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/m4_ic_back" app:tint="#FFFFFF" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m4_qr_back" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/m4_scan_qr" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/m4_qr_subtitle" android:textColor="#BCE4D8" android:textSize="13sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/m4QrTorch" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/m4_ic_torch" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/m4_qr_torch_on" android:visibility="gone" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <FrameLayout android:id="@+id/m4QrCameraPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#091422">
            <androidx.camera.view.PreviewView android:id="@+id/m4QrPreview" android:layout_width="match_parent" android:layout_height="match_parent" />
            <com.smartsolar.microgrid.member4.qr.QrViewfinder android:id="@+id/m4QrFrame" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
            <TextView android:id="@+id/m4QrScanIndicator" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal" android:layout_margin="24dp" android:padding="14dp"
                android:background="@drawable/m4_qr_dark_panel" android:text="@string/m4_qr_opening" android:textSize="14sp" android:textColor="#BCE4D8" android:accessibilityLiveRegion="polite" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
                android:layout_margin="20dp" android:padding="20dp" android:orientation="vertical" android:background="@drawable/m4_qr_dark_panel">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/m4_qr_guide"
                    android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFFFF" android:gravity="center" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="@string/m4_qr_hint" android:textSize="14sp" android:textColor="#BCE4D8" android:gravity="center" />
            </LinearLayout>
        </FrameLayout>
        <ScrollView android:id="@+id/m4QrResultPanel" android:layout_width="match_parent" android:layout_height="match_parent"
            android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                <ProgressBar android:id="@+id/m4QrProgress" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:layout_marginTop="24dp" android:indeterminateTint="#009B73" />
                <TextView android:id="@+id/m4QrStatusBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal" android:padding="14dp" android:textColor="#047857" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/m4QrResultTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:textColor="#163D32" android:textSize="26sp" android:textStyle="bold" android:gravity="center" android:accessibilityLiveRegion="polite" />
                <TextView android:id="@+id/m4QrResultMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textColor="#52675E" android:textSize="15sp" android:gravity="center" />
                <com.google.android.material.card.MaterialCardView android:id="@+id/m4QrDetailsCard" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="24dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="#DCE8E2" app:strokeWidth="1dp" app:cardBackgroundColor="#FFFFFF">
                    <LinearLayout android:id="@+id/m4QrDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical" />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton android:id="@+id/m4QrPrimary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="56dp" android:layout_marginTop="24dp" android:text="@string/m4_qr_complete" android:textAllCaps="false" android:textColor="#FFFFFF" app:backgroundTint="#009B73" app:cornerRadius="16dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/m4QrAgain" style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="8dp"
                    android:text="@string/m4_qr_scan_again" android:textAllCaps="false" android:textColor="#047857" app:strokeColor="#BDD8CB" app:cornerRadius="16dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/m4QrHistory" style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/m4_qr_completed_jobs" android:textAllCaps="false" android:textColor="#047857" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
