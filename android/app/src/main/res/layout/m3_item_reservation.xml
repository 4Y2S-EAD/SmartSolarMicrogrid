<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E5E7EB"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Station Icon, Name, Slot and Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Station Icon Box -->
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_rounded_input"
                android:backgroundTint="#ECFDF5">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_compass"
                    app:tint="#059669" />
            </FrameLayout>

            <!-- Station Name & Slot Number -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Solar Hub Station"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvSlotNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Slot No : 1"
                    android:textColor="#6B7280"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Approved"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textColor="#15803D"
                android:background="@drawable/bg_rounded_input"
                android:backgroundTint="#DCFCE7" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F3F4F6"
            android:layout_marginVertical="12dp" />

        <!-- Details Box (Date & Time) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_rounded_input"
            android:backgroundTint="#F9FAFB"
            android:padding="12dp">

            <!-- Date Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_today"
                    app:tint="#6B7280" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Booking Date"
                    android:textColor="#6B7280"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tvBookingDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2026-09-25"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Time Slot Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="#6B7280" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Time Slot"
                    android:textColor="#6B7280"
                    android:textSize="12sp"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/tvTimeSlot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:00 AM - 10:00 AM"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Cancellation Reason -->
        <TextView
            android:id="@+id/tvCancellationReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reason: Changed schedule"
            android:textColor="#DC2626"
            android:textSize="11sp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Reservation ID & Action Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvReservationId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ID: #678..."
                android:textColor="#9CA3AF"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="middle" />

            <!-- QR Code Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQrCode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="QR Code"
                android:textSize="12sp"
                android:textColor="#059669"
                app:icon="@drawable/ic_qr_code_24"
                app:iconTint="#059669"
                app:iconSize="16dp"
                app:strokeColor="#A7F3D0"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                app:backgroundTint="#ECFDF5"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
