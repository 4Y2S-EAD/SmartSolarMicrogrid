<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/white"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grid Operator Dashboard"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/emerald_600"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnQrApproval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="QR Approvals"
        android:backgroundTint="@color/emerald_500"
        android:textColor="@color/white"
        android:padding="16dp"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnManagement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="System Management"
        android:backgroundTint="@color/emerald_600"
        android:textColor="@color/white"
        android:padding="16dp"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:backgroundTint="@color/rose_500"
        android:textColor="@color/white"
        android:padding="16dp"
        android:textAllCaps="false"
        android:textSize="18sp"/>

</LinearLayout>
