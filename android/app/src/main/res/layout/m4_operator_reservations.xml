<?xml version="1.0" ?>
<!-- Member 4: native reservation list and server query controls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F3F7F4">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="12dp" android:background="#047857">
        <com.google.android.material.button.MaterialButton android:id="@+id/m4OperatorBack"
            android:layout_width="48dp" android:layout_height="48dp"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="12dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:contentDescription="@string/m4_operator_back"
            android:tooltipText="@string/m4_operator_back"
            app:icon="@drawable/m4_ic_back" app:iconSize="24dp" app:iconPadding="0dp"
            app:iconGravity="textStart" app:iconTint="@android:color/white"
            app:cornerRadius="24dp" app:backgroundTint="@android:color/transparent"/>
        <TextView android:id="@+id/m4OperatorTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="19sp" android:textStyle="bold" android:textColor="#FFFFFF" android:paddingHorizontal="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/m4OperatorRefresh"
            android:layout_width="48dp" android:layout_height="48dp"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="12dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:contentDescription="@string/m4_operator_refresh"
            android:tooltipText="@string/m4_operator_refresh"
            app:icon="@drawable/m4_ic_refresh" app:iconSize="24dp" app:iconPadding="0dp"
            app:iconGravity="textStart" app:iconTint="@android:color/white"
            app:cornerRadius="24dp" app:backgroundTint="@android:color/transparent"/>
    </LinearLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="12dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/m4TabAll" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="All" android:textAllCaps="false" app:cornerRadius="12dp" android:layout_marginEnd="6dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/m4TabPending" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Pending" android:textAllCaps="false" app:cornerRadius="12dp" android:layout_marginEnd="6dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/m4TabApproved" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Approved" android:textAllCaps="false" app:cornerRadius="12dp" android:layout_marginEnd="6dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/m4TabCompleted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Completed" android:textAllCaps="false" app:cornerRadius="12dp" android:layout_marginEnd="6dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/m4TabHistory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Cancelled" android:textAllCaps="false" app:cornerRadius="12dp" android:layout_marginEnd="6dp"/>
        </LinearLayout>
    </HorizontalScrollView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/m4TabSearch"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" android:gravity="start|center_vertical"
        android:paddingHorizontal="18dp" android:text="@string/m4_search_bookings_filters"
        android:textAllCaps="false" android:textSize="14sp" android:textColor="#526B60"
        app:icon="@drawable/m4_ic_search" app:iconTint="#047857"
        app:iconSize="22dp" app:iconPadding="12dp" app:cornerRadius="28dp"
        app:strokeColor="#D7E8DE" app:backgroundTint="#FFFFFF" />
    <ScrollView android:id="@+id/m4OperatorFilters" android:layout_width="match_parent" android:layout_height="260dp" android:layout_marginHorizontal="16dp" android:layout_marginBottom="8dp" android:background="@drawable/m4_search_panel" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:hint="Booking ID"
                app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/m4FilterId" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="Booking ID" android:inputType="text" android:maxLines="1" android:maxLength="24" android:importantForAutofill="no"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:hint="Prosumer NIC"
                app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/m4FilterNic" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="Prosumer NIC" android:inputType="text" android:maxLines="1" android:maxLength="32" android:importantForAutofill="no"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:hint="Station name or ID"
                app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/m4FilterStation" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="Station name or ID" android:inputType="text" android:maxLines="1" android:maxLength="100" android:importantForAutofill="no"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" android:hint="Booking date (yyyy-MM-dd)"
                app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp" app:boxCornerRadiusBottomEnd="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/m4FilterDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:contentDescription="Booking date (yyyy-MM-dd)" android:inputType="text" android:maxLines="1" android:maxLength="10" android:importantForAutofill="no" android:focusable="false"/>
            </com.google.android.material.textfield.TextInputLayout>
            <Spinner android:id="@+id/m4FilterStatus" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="Reservation status"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton android:id="@+id/m4FilterSubmit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/m4_apply_search" android:textAllCaps="false" app:cornerRadius="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/m4FilterClear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Clear filters" android:textAllCaps="false" app:cornerRadius="12dp" android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <ProgressBar android:id="@+id/m4OperatorLoading" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:indeterminate="true"/>
    <TextView android:id="@+id/m4OperatorMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#193C2D" android:padding="16dp" android:accessibilityLiveRegion="polite"/>
    <TextView android:id="@+id/m4OperatorFeedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#193C2D" android:padding="16dp" android:accessibilityLiveRegion="polite"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/m4ReservationList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="12dp" android:clipToPadding="false"/>
    <TextView android:id="@+id/m4PageInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="#193C2D" android:gravity="center"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
        <com.google.android.material.button.MaterialButton android:id="@+id/m4PreviousPage"
            android:layout_width="48dp" android:layout_height="48dp"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="12dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:contentDescription="@string/m4_operator_previous"
            android:tooltipText="@string/m4_operator_previous"
            app:icon="@drawable/m4_ic_back" app:iconSize="24dp" app:iconPadding="0dp"
            app:iconGravity="textStart" app:iconTint="@android:color/white"
            app:cornerRadius="24dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/m4NextPage"
            android:layout_width="48dp" android:layout_height="48dp"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="12dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:contentDescription="@string/m4_operator_next"
            android:tooltipText="@string/m4_operator_next"
            app:icon="@drawable/m4_ic_next" app:iconSize="24dp" app:iconPadding="0dp"
            app:iconGravity="textStart" app:iconTint="@android:color/white"
            app:cornerRadius="24dp" android:layout_marginStart="12dp"/>
    </LinearLayout>
</LinearLayout>
