<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="26dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Create Prosumer Account"
            android:textColor="@color/gray_900"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Join the Smart Solar Microgrid network."
            android:textColor="@color/gray_500"
            android:textSize="14sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="PERSONAL INFORMATION"
            android:textColor="@color/emerald_600"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etNIC"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_input"
            android:hint="NIC Number"
            android:textColor="@color/gray_900"
            android:textColorHint="@color/gray_500"
            android:paddingHorizontal="16dp"/>

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_input"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:textColor="@color/gray_900"
            android:textColorHint="@color/gray_500"
            android:paddingHorizontal="16dp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_input"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:textColor="@color/gray_900"
            android:textColorHint="@color/gray_500"
            android:paddingHorizontal="16dp"/>

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_input"
            android:hint="Phone Number"
            android:inputType="phone"
            android:textColor="@color/gray_900"
            android:textColorHint="@color/gray_500"
            android:paddingHorizontal="16dp"/>

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_input"
            android:gravity="top"
            android:hint="Address"
            android:inputType="textPostalAddress|textMultiLine"
            android:textColor="@color/gray_900"
            android:textColorHint="@color/gray_500"
            android:padding="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="ACCOUNT SECURITY"
            android:textColor="@color/emerald_600"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_input"
            android:hint="Password"
            android:inputType="textPassword"
            android:textColor="@color/gray_900"
            android:textColorHint="@color/gray_500"
            android:paddingHorizontal="16dp"/>

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_input"
            android:hint="Confirm Password"
            android:inputType="textPassword"
            android:textColor="@color/gray_900"
            android:textColorHint="@color/gray_500"
            android:paddingHorizontal="16dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_rounded_button"
            android:text="CREATE ACCOUNT"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:elevation="2dp"/>

        <TextView
            android:id="@+id/tvLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="Already have an account? Sign In"
            android:textColor="@color/emerald_600"
            android:textStyle="bold"/>

    </LinearLayout>

</ScrollView>