<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <Space
            android:layout_width="1dp"
            android:layout_height="70dp"/>

        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:gravity="center"
            android:text="☀"
            android:textSize="42sp"
            android:backgroundTint="#FFC107"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Smart Solar Microgrid"
            android:textColor="@color/gray_900"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Prosumer Management Portal"
            android:textColor="@color/gray_500"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:text="Welcome back"
            android:textColor="@color/gray_900"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sign in to continue to your account."
            android:textColor="@color/gray_500"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/etNIC"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_rounded_input"
            android:hint="NIC Number"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="@color/gray_900"
            android:textColorHint="@color/gray_500"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_rounded_input"
            android:hint="Password"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="@color/gray_900"
            android:textColorHint="@color/gray_500"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_rounded_button"
            android:text="SIGN IN"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:elevation="2dp"/>

        <TextView
            android:id="@+id/tvRegister"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="New Solar Prosumer?  Create Account"
            android:textColor="@color/emerald_600"
            android:textSize="14sp"
            android:textStyle="bold"/>

    </LinearLayout>

</ScrollView>