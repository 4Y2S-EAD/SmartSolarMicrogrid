        "body": {
          "mode": "raw",
          "raw": "{\n  \"nic\": \"{{m1ProsumerNic}}\",\n  \"password\": \"WrongPassword999!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/member1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "member1",
            "auth",
            "login"
          ]
        },
        "description": "TC-03: Negative authentication test verifying that incorrect passwords result in HTTP 401 Unauthorized."
      }
    },
    {
      "name": "M1-TC-04: GET Prosumer Profile by Valid NIC (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
