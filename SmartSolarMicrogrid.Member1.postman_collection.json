    {
      "name": "M1-TC-09: GET All Internal Users (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"User list is an array and contains created grid operator\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "    var targetNic = pm.collectionVariables.get(\"m1OperatorNic\") || (pm.environment ? pm.environment.get(\"m1OperatorNic\") : null);",
              "    if (targetNic) {",
              "        var foundUser = jsonData.find(u => u.nic === targetNic);",
              "        pm.expect(foundUser).to.not.be.undefined;",
              "        pm.expect(foundUser.role).to.eql(\"grid_operator\");",
              "        pm.expect(foundUser.full_name).to.eql(\"Ruwan Perera\");",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
