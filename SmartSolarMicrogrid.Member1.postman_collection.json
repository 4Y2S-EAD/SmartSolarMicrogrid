    {
      "name": "M1-TC-08: POST Create Internal User (Grid Operator) (200 OK)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var randomOp = Math.floor(1000000 + Math.random() * 9000000);",
              "var operatorNic = \"88\" + randomOp + \"V\";",
              "var operatorEmail = \"operator_\" + randomOp + \"@smartsolar.io\";",
              "pm.collectionVariables.set(\"m1OperatorNic\", operatorNic);",
              "pm.collectionVariables.set(\"m1OperatorEmail\", operatorEmail);",
              "if (pm.environment) {",
              "    pm.environment.set(\"m1OperatorNic\", operatorNic);",
              "    pm.environment.set(\"m1OperatorEmail\", operatorEmail);",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response confirms user created successfully\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"message\");",
              "    pm.expect(jsonData.message).to.eql(\"User created successfully.\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nic\": \"{{m1OperatorNic}}\",\n  \"full_name\": \"Ruwan Perera\",\n  \"email\": \"{{m1OperatorEmail}}\",\n  \"password\": \"Password123!\",\n  \"role\": \"grid_operator\",\n  \"badge_id\": \"OP-778\",\n  \"assigned_hub_id\": \"Hub-Colombo-01\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/member1/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "member1",
            "users"
          ]
        },
        "description": "TC-08: Creates an internal Grid Operator account with badge number and hub assignment."
      }
