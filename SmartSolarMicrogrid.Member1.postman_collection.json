  "item": [
    {
      "name": "M1-TC-01: POST Register New Prosumer (200 OK)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var randomId = Math.floor(1000000 + Math.random() * 9000000);",
              "var prosumerNic = \"99\" + randomId + \"V\";",
              "var prosumerEmail = \"prosumer_\" + randomId + \"@smartsolar.io\";",
              "pm.collectionVariables.set(\"m1ProsumerNic\", prosumerNic);",
              "pm.collectionVariables.set(\"m1ProsumerEmail\", prosumerEmail);",
              "if (pm.environment) {",
              "    pm.environment.set(\"m1ProsumerNic\", prosumerNic);",
              "    pm.environment.set(\"m1ProsumerEmail\", prosumerEmail);",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Registration response message confirms pending activation\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"message\");",
              "    pm.expect(jsonData.message).to.include(\"Registration submitted successfully\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nic\": \"{{m1ProsumerNic}}\",\n  \"fullName\": \"Chaminda Vaas\",\n  \"email\": \"{{m1ProsumerEmail}}\",\n  \"password\": \"Password123!\",\n  \"phoneNumber\": \"0771234567\",\n  \"address\": \"No. 12, Highlevel Road, Colombo\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/member1/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "member1",
            "auth",
            "register"
          ]
        },
        "description": "TC-01: Registers a new prosumer with dynamically generated NIC and email to guarantee unique, collision-free testing."
      }
    },
    {
      "name": "M1-TC-02: POST Login as Registered Prosumer (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Login response returns JWT token and user details\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"token\");",
              "    pm.expect(jsonData.token).to.be.a(\"string\");",
              "    pm.expect(jsonData).to.have.property(\"user\");",
              "    pm.expect(jsonData.user.nic).to.eql(pm.collectionVariables.get(\"m1ProsumerNic\"));",
              "    pm.collectionVariables.set(\"m1AuthToken\", jsonData.token);",
              "    if (pm.environment) {",
              "        pm.environment.set(\"m1AuthToken\", jsonData.token);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nic\": \"{{m1ProsumerNic}}\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/member1/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "member1",
            "auth",
            "login"
          ]
        },
        "description": "TC-02: Authenticates the registered prosumer and captures the signed JWT token."
      }
    },
