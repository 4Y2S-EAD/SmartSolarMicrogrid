      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains array with newly created slot\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "    pm.expect(jsonData.length).to.be.at.least(1);",
              "    var targetSlotId = pm.collectionVariables.get(\"member2SlotId\") || (pm.environment ? pm.environment.get(\"member2SlotId\") : null);",
              "    if (targetSlotId) {",
              "        var foundSlot = jsonData.find(s => s.slotId === targetSlotId);",
              "        pm.expect(foundSlot).to.not.be.undefined;",
              "        pm.expect(foundSlot.slotNumber).to.eql(1);",
              "        pm.expect(foundSlot.status).to.eql(\"Available\");",
              "    }",
              "});"
            ],
