              "    pm.expect(jsonData).to.have.property(\"stationId\");",
              "    pm.expect(jsonData.stationId).to.be.a(\"string\");",
              "    pm.expect(jsonData.message).to.include(\"created successfully\");",
              "    // Automatically save stationId for next test cases",
              "    pm.collectionVariables.set(\"member2StationId\", jsonData.stationId);",
              "    if (pm.environment) {",
              "        pm.environment.set(\"member2StationId\", jsonData.stationId);",
              "    }",
              "});"
            ],
