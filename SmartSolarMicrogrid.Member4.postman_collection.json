    {
      "name": "2. Operator Dashboard",
      "item": [
        {
          "name": "DASH-01: Get Operator Global Dashboard & Metrics (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response schema contains Items and Summary\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('items');",
                  "    pm.expect(json).to.have.property('currentPage');",
                  "    pm.expect(json).to.have.property('pageSize');",
                  "    pm.expect(json).to.have.property('totalRecords');",
                  "    pm.expect(json).to.have.property('totalPages');",
                  "    pm.expect(json).to.have.property('summary');",
                  "    pm.expect(json).to.have.property('statusOptions');",
                  "});",
                  "",
                  "pm.test(\"Dashboard Summary Counts Math Accuracy\", function () {",
                  "    var summary = pm.response.json().summary;",
                  "    pm.expect(summary).to.have.property('activeCount');",
                  "    pm.expect(summary).to.have.property('pendingCount');",
                  "    pm.expect(summary).to.have.property('approvedCount');",
                  "    pm.expect(summary).to.have.property('completedCount');",
                  "    // In backend service: activeCount = pendingCount + approvedCount",
                  "    pm.expect(summary.activeCount).to.eql(summary.pendingCount + summary.approvedCount);",
                  "});",
                  "",
                  "pm.test(\"Status Options contains standard reservation statuses\", function () {",
                  "    var opts = pm.response.json().statusOptions;",
                  "    pm.expect(opts).to.include.members(['Pending', 'Approved', 'Completed', 'Cancelled']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/operator/reservations?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "operator", "reservations"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            }
          }
        },
        {
