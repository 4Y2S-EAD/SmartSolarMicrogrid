    {
      "name": "7. QR Code Verification",
      "item": [
        {
          "name": "QR-01: Verify Authentic QR Code (Success - 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"QR Verification status is VALID and code is QR_VERIFIED\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.result).to.eql('VALID');",
                  "    pm.expect(json.code).to.eql('QR_VERIFIED');",
                  "    pm.expect(json).to.have.property('reservation');",
                  "    pm.expect(json.reservation).to.have.property('reservationId');",
                  "    pm.expect(json.reservation.status).to.eql('Approved');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrData\": \"{{validQrData}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/operator/verify-qr",
              "host": ["{{baseUrl}}"],
              "path": ["api", "operator", "verify-qr"]
            }
          }
        },
        {
          "name": "QR-02: Verify Corrupt/Invalid QR Signature (Negative - 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Result is REJECTED with INVALID_QR code\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.result).to.eql('REJECTED');",
                  "    pm.expect(json.code).to.eql('INVALID_QR');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrData\": \"{\\\"data\\\": {\\\"tampered\\\": true}, \\\"signature\\\": \\\"d3Jvbmc=\\\"}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/operator/verify-qr",
              "host": ["{{baseUrl}}"],
              "path": ["api", "operator", "verify-qr"]
            }
          }
        },
